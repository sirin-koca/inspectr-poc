    {
      "id": "TK.MUNDATRequirements",
      "label": "MUNDAT Data-Sharing Requirements",
      "level": "Domain",
      "description": "Design-time requirements derived from the Trondheim Kommune MUNDAT data-sharing use case",
      "color": "#2E86AB",
      "children": [
        {
          "id": "TK.MUNDAT.Structure",
          "label": "Pipeline Structure",
          "level": "Dimension",
