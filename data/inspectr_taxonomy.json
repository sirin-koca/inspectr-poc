              "evidence_fields": ["compliance_extensions.source_id", "compliance_extensions.approved_source"]
            }
          ]
        },
        {
          "id": "TK.MUNDAT.RiskAssessment",
          "label": "DPIA and Risk Assessment",
          "level": "Dimension",
          "description": "Compliance and risk checks occur during the data-sharing flow",
          "children": [
            {
              "id": "Constraint.TK.RiskChecks",
              "label": "Compliance and Risk Checks",
              "level": "Constraint",
              "description": "The pipeline contains a dedicated stage for compliance, DPIA, and obligation checks",
              "rule_id": "TK-RISK-01",
              "evidence_fields": ["pipeline.nodes.label"]
            }
          ]
        },
        {
          "id": "TK.MUNDAT.Traceability",
          "label": "Logging and Traceability",
          "level": "Dimension",
          "description": "The request, data access, checks, and sharing decision should be traceable",
